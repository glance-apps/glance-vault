# Copy to .env and fill in. docker-compose reads this file.
# Generate a long random token, for example: openssl rand -hex 32
GLANCEVAULT_DEVICE_TOKEN=replace-with-a-long-random-secret

# Optional overrides (defaults shown).
# GLANCEVAULT_PORT=8080
# GLANCEVAULT_STORAGE_PATH=/data/glancevault.db

# Auth model: "shared" (default) or "per-account". "shared" is the model this
# server implements: one instance-wide device token, with each request naming the
# account it acts on — correct for a single household or operator running their
# own instance. "per-account" (per-device credentials the server resolves to an
# account itself) is NOT IMPLEMENTED YET: setting it changes no request handling
# and only logs a warning at startup. Leave it unset unless you are developing
# that path. Unlike the on/off settings below, an unrecognized value here is
# refused at startup rather than falling back to the default.
# GLANCEVAULT_AUTH_MODE=shared

# Enrollment bootstrap secret, REQUIRED when GLANCEVAULT_AUTH_MODE=per-account
# (the server refuses to start without it in that mode; ignored in shared mode,
# where POST /enroll is not registered at all). A device presents this once at
# POST /enroll to receive its own per-device credential, then discards it.
# Use a distinct value from GLANCEVAULT_DEVICE_TOKEN; generate the same way:
# openssl rand -hex 32
# GLANCEVAULT_ENROLLMENT_SECRET=replace-with-a-different-long-random-secret

# Content-addressed blob store (lifeGLANCE media). Bytes are opaque ciphertext
# the server never decrypts. Defaults to a "blobs" directory next to the SQLite
# file. GLANCEVAULT_MAX_BLOB_SIZE is the server-side cap in bytes (default 1 GiB,
# 1073741824); the operator sets it per tier and the server rejects anything
# larger regardless of the client's pre-upload check.
# GLANCEVAULT_BLOB_STORE_PATH=/data/blobs
# GLANCEVAULT_MAX_BLOB_SIZE=1073741824

# Blob reclaim (garbage collection). DEFAULT IS RETAIN: reclaim is OFF and blobs
# at zero references are kept forever (zero data-loss risk, correct for a
# self-hoster). Turn it on ONLY as a deliberate opt-in. When on, a blob is
# deleted only once ALL of: zero references, grace elapsed since last reference
# activity, AND every non-dead device has acked past the point the blob hit zero.
# A device idle longer than the dead-device threshold is treated as gone and no
# longer blocks reclaim.
# GLANCEVAULT_BLOB_RECLAIM=on
# GLANCEVAULT_BLOB_GRACE_PERIOD_DAYS=30
# GLANCEVAULT_BLOB_DEAD_DEVICE_DAYS=90
# GLANCEVAULT_BLOB_RECLAIM_INTERVAL_MINUTES=60

# Comma-separated list of origins allowed for browser/desktop CORS requests.
# Empty or unset means no cross-origin requests are allowed. A single "*" allows
# any. Include EVERY client origin that connects cross-origin:
#   - app://dayglance      the dayGLANCE Electron desktop renderer's fixed origin.
#                          REQUIRED, or the desktop app's SSE/fetch is blocked and
#                          it silently falls back to polling.
#   - your production web origin(s), e.g. https://app.example.com — replace the
#     placeholder below with the real dayGLANCE web app origin(s) you serve.
# The origin must match exactly (scheme + host + port), so list each one.
# GLANCEVAULT_ALLOWED_ORIGINS=app://dayglance,https://app.example.com

# Request logging: one concise line per request (method, redacted route template,
# status, duration), skipping the /healthz health check. On by default; the first
# thing to check when a client "does nothing". The query string and dynamic path
# segments (entityId, blob hash) are stripped so no per-user data is logged. Set
# to off/false/0/no to silence it.
# GLANCEVAULT_REQUEST_LOG=on

# Reverse-proxy / client IP. The server sits behind a TLS-terminating proxy, so
# per-IP rate limiting needs to know which hop to trust for X-Forwarded-For.
# Default "loopback" trusts a proxy on localhost (the compose setup). Set to a
# hop count (e.g. 1) or an address if your topology differs.
# GLANCEVAULT_TRUST_PROXY=loopback

# Per-IP rate limiting (coarse abuse backstop on top of the proxy). On by default.
# Window in seconds and max requests per IP per window (default 60s / 600).
# GLANCEVAULT_RATE_LIMIT=on
# GLANCEVAULT_RATE_LIMIT_WINDOW_SECONDS=60
# GLANCEVAULT_RATE_LIMIT_MAX=600

# Process-wide ceiling on total concurrent SSE (/events) connections across all
# accounts (the per-account cap is 64). Default 1024.
# GLANCEVAULT_MAX_SSE_CONNECTIONS=1024

# Stale resumable-upload reaper: an abandoned (never-finalized) upload session and
# its staged part bytes are swept once older than the TTL. Always on; it only ever
# removes transfer-layer scratch, never a finalized blob. Defaults: 24h / 60min.
# GLANCEVAULT_UPLOAD_SESSION_TTL_HOURS=24
# GLANCEVAULT_UPLOAD_SESSION_SWEEP_MINUTES=60
