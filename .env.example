# Copy to .env and fill in. docker-compose reads this file.
# Generate a long random token, for example: openssl rand -hex 32
GLANCEVAULT_DEVICE_TOKEN=replace-with-a-long-random-secret

# Optional overrides (defaults shown).
# GLANCEVAULT_PORT=8080
# GLANCEVAULT_STORAGE_PATH=/data/glancevault.db

# Content-addressed blob store (lifeGLANCE media). Bytes are opaque ciphertext
# the server never decrypts. Defaults to a "blobs" directory next to the SQLite
# file. GLANCEVAULT_MAX_BLOB_SIZE is the server-side cap in bytes (default 1 GiB,
# 1073741824); the operator sets it per tier and the server rejects anything
# larger regardless of the client's pre-upload check.
# GLANCEVAULT_BLOB_STORE_PATH=/data/blobs
# GLANCEVAULT_MAX_BLOB_SIZE=1073741824

# Comma-separated list of origins allowed for browser CORS requests. Empty or
# unset means no cross-origin requests are allowed. A single "*" allows any.
# GLANCEVAULT_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
