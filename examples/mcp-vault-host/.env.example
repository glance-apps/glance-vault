# Required. The device token every dayGLANCE device also uses. Generate: openssl rand -hex 32
GLANCEVAULT_DEVICE_TOKEN=

# Required. Your dayGLANCE sync passphrase (typed on the device when sync was set up).
# It stays in this container's memory only; the vault stores ciphertext regardless.
MCP_PASSPHRASE=

# Required. Bearer token AI clients present to the MCP endpoint. Generate: openssl rand -hex 32
MCP_BEARER_TOKEN=

# Required. The vault account namespace the host pulls. dayGLANCE generates it on first
# GLANCEvault sync; it is not shown in the app UI yet (see the issue thread). Read it from
# the vault database: sqlite3 -readonly /path/to/data/glancevault.db 'select * from accounts;'
MCP_ACCOUNT_ID=

# Optional. Single address switch for both published ports; also auto-added to the MCP
# Host allowlist (put proxy hostnames in MCP_ALLOWED_HOSTS when you reverse-proxy by name).
#BIND_ADDR=127.0.0.1
#VAULT_PORT=8080
#MCP_PORT=7893

# Optional, defaults shown.
#TZ=UTC
#MCP_USER_TIMEZONE=UTC          IANA zone; without it a server on UTC misreads the user's evening as "tomorrow"
#MCP_WEEK_START=1               1=Monday, 0=Sunday
#MCP_USER_ID=                   which user a multi-user account serves (empty in single-user setups)
#GLANCEVAULT_ALLOWED_ORIGINS=app://dayglance   keep app://dayglance or the desktop app silently falls back to polling
#MCP_ALLOWED_HOSTS=             proxy hostnames only (BIND_ADDR's own value is added automatically)
#MCP_ALLOWED_ORIGINS=           browser origins only; CLI clients send no Origin
