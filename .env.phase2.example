# Phase 2 losslessness check configuration. Copy to .env.phase2 and fill in,
# then run:  npx tsx scripts/losslessness-check.ts
# (load it however you prefer, for example: set -a; . ./.env.phase2; set +a)
#
# This script is READ-ONLY with respect to your app data. It reads the file-tier
# sync payload, seeds a running GLANCEvault server, and diffs the round trip. It
# never modifies your WebDAV files or app data and never decrypts anything.

# Base URL of the running GLANCEvault server to seed and read back.
VAULT_URL=http://localhost:8080

# The device auth token the server was started with (the shared secret).
VAULT_TOKEN=replace-with-your-device-token

# Base account id for the check. A per-app suffix is added automatically
# (lossless-check-dayglance, etc.) so these rows are easy to tell apart from
# real household data in the SQLite file.
ACCOUNT_ID=lossless-check

# Absolute paths to each app's file-tier sync directory on this machine. These
# are the WebDAV / iCloud Drive directories that hold one <entityId>.json file
# per entity. Each must exist and contain at least one .json file.
SYNC_DIR_DAYGLANCE=/path/to/dayglance/sync
SYNC_DIR_LASTGLANCE=/path/to/lastglance/sync
SYNC_DIR_LIFEGLANCE=/path/to/lifeglance/sync
