{
  "storagePath": "./data/glancevault.db",
  "authMode": "shared",
  "_quotaNote": "quota* keys are optional; unset means no enforcement. Values are illustrative placeholders - size against real disk.",
  "enrollmentSecret": "replace-with-a-different-long-random-secret",
  "port": 8080,
  "deviceToken": "replace-with-a-long-random-secret",
  "allowedOrigins": [
    "app://dayglance",
    "https://app.example.com"
  ],
  "blobStorePath": "./data/blobs",
  "maxBlobSize": 1073741824,
  "blobReclaim": false,
  "blobGracePeriodDays": 30,
  "blobDeadDevicePeriodDays": 90,
  "blobReclaimIntervalMinutes": 60,
  "trustProxy": "loopback",
  "rateLimit": true,
  "rateLimitWindowSeconds": 60,
  "rateLimitMax": 600,
  "maxSseConnections": 1024,
  "uploadSessionTtlHours": 24,
  "uploadSessionSweepMinutes": 60
}
